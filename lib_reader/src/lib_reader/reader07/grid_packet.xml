        </uscount>
        <temp_sipm repeat="1">
            <start>23</start>
            <size>2</size>
            <len>4</len>
        </temp_sipm>
        <temp_adc repeat="1">
            <start>31</start>
            <size>2</size>
            <len>4</len>
        </temp_adc>
        <v_mon repeat="1">
            <start>39</start>
            <size>2</size>
            <len>4</len>
        </v_mon>
        <i_mon repeat="1">
            <start>47</start>
