         body + 3-byte tail, then a 2-byte CRC outside the 510-byte frame.
         The body holds 1 primary event plus 43 sub-events (11-byte step). -->
    <hex_sci_packet packet_len="510" head="0xaa;0xbb;0xcc" tail="0xdd;0xee;0xff">
        <channel>
            <start>3</start>
            <size>1</size>
            <len>1</len>
        </channel>
        <uscount>
            <start>4</start>
            <size>8</size>
            <len>1</len>
        </uscount>
        <data_max>
            <start>12</start>
            <size>2</size>
            <len>1</len>
        </data_max>
        <sub_channel repeat="1">
            <start>26</start>
            <size>1</size>
            <len>1</len>
        </sub_channel>
        <sub_uscount repeat="1">
            <start>27</start>
            <size>8</size>
            <len>1</len>
        </sub_uscount>
        <sub_amp repeat="1">
            <start>35</start>
            <size>2</size>
            <len>1</len>
        </sub_amp>
        <effective_count>
            <start>499</start>
            <size>4</size>
            <len>1</len>
        </effective_count>
        <missing_count>
            <start>503</start>
            <size>4</size>
            <len>1</len>
        </missing_count>
    </hex_sci_packet>

    <!-- Telemetry packet: 3-byte head + 7 records x 70 bytes + 3-byte tail
