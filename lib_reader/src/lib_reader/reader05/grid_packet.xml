<?xml version="1.0"?>
<grid>
    <!-- GRID 05B / 03B waveform science packet: 8-byte head + 512-byte
         waveform + 32-byte trailer + 8-byte tail.  Only the event fields are
         declared; the waveform samples are skipped. -->
    <sci_wf_packet packet_len="560" head="0x5a;0x5a;0x5a;0x5a;0x5a;0x5a;0x5a;0x5a" tail="0xaa;0xaa;0xaa;0xaa;0xaa;0xaa;0xaa;0xaa">
        <channel>
            <start>8</start>
            <size>2</size>
            <len>1</len>
        </channel>
        <event_number>
            <start>12</start>
            <size>4</size>
            <len>1</len>
        </event_number>
        <timestamp>
            <start>528</start>
            <size>8</size>
            <len>1</len>
        </timestamp>
        <data_max>
            <start>544</start>
            <size>2</size>
            <len>1</len>
        </data_max>
        <data_base>
            <start>546</start>
            <size>2</size>
            <len>1</len>
        </data_base>
        <CRC skip0="0" skip1="2">
            <start>550</start>
            <size>2</size>
            <len>1</len>
        </CRC>
    </sci_wf_packet>

    <!-- GRID 03B feature science packet: 8-byte head + 20 events x 24 bytes +
         8-byte tail.  The CRC field is cumulative over the preceding events. -->
    <sci_ft_packet packet_len="504" head="0x5a;0x5a;0x99;0x66;0x99;0x66;0x5a;0x5a" tail="0xaa;0xaa;0x99;0x66;0x99;0x66;0xaa;0xaa">
        <channel>
            <start>8</start>
            <size>2</size>
            <len>1</len>
        </channel>
        <event_number>
            <start>12</start>
            <size>4</size>
            <len>1</len>
        </event_number>
        <evt_timestamp repeat="1">
            <start>16</start>
            <size>8</size>
            <len>1</len>
        </evt_timestamp>
        <evt_data_max repeat="1">
            <start>32</start>
            <size>2</size>
            <len>1</len>
        </evt_data_max>
        <evt_data_base repeat="1">
            <start>34</start>
            <size>2</size>
            <len>1</len>
        </evt_data_base>
        <CRC repeat="1" skip0="0" skip1="2">
            <start>38</start>
            <size>2</size>
            <len>1</len>
        </CRC>
    </sci_ft_packet>
</grid>
